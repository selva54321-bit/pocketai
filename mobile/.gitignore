# =============================================================================
# PocketAI Mobile (.gitignore - React Native & Android)
# =============================================================================

# Node Dependencies
node_modules/
.npm
.pnp
.pnp.js

# React Native & Metro Bundler
.metro-health-check*
.expo/
*.jsbundle

# Logs & Debug Output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Android Build Outputs & Intermediate Files
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/
android/app/.cxx/
android/app/.externalNativeBuild/
android/captures/
*.apk
*.ap_
*.aab
*.dex
*.class

# Android Studio & IDE
android/.idea/
android/*.iml
android/app/*.iml
.idea/
.vscode/
*.swp
*.swo

# Keystores & Signing (preserve debug.keystore, ignore production keys)
*.keystore
*.jks
!android/app/debug.keystore

# Environment & Secrets
.env
.env.*
.env.local
!.env.example

# OS Specific
.DS_Store
.DS_Store?
._*
Thumbs.db
